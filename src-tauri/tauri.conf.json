{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portabl Apps",
  "identifier": "dev.portablapps.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Porta[b]l Apps",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#0b0614"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
